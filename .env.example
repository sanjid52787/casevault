# ==============================================================================
# CaseVault - Environment Configuration Template (.env.example)
# Organization: Northbridge Cyber Response
# University Assessment: CYS22301 Software and Platform Security (Level 6)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Generate secure random secrets using the provided Python commands.
# 3. NEVER commit the actual '.env' file to source control.
# ==============================================================================

# Application Environment ('development', 'testing', 'production')
CASEVAULT_ENV=development

# Debug Mode: Set to False in production. In development, keep True only for local debugging.
# Hard rule: In production, DEBUG must always be False to prevent stack trace information disclosure.
DEBUG=False

# Django Secret Key (50+ cryptographically secure characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGEME_USE_COMMAND_ABOVE_TO_GENERATE_A_64_CHAR_SECRET_KEY

# Allowed Hosts (comma-separated list of hostnames/IPs)
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# CSRF Trusted Origins (comma-separated origins including scheme)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (Defaults to secure local SQLite in dev; PostgreSQL in production)
DATABASE_URL=sqlite:///casevault_dev.sqlite3

# ==============================================================================
# Cryptographic Keys (CaseVault Security Subsystem)
# ==============================================================================
# Evidence Encryption Master Key (AES-256-GCM / Fernet compliant: 32 bytes base64 encoded)
# Used for encrypting evidence at rest in the vault.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CASEVAULT_EVIDENCE_KEY=CHANGEME_GENERATE_BASE64_32_BYTE_FERNET_KEY

# Audit Trail HMAC Integrity Key (32+ cryptographically secure bytes)
# Used for generating tamper-evident cryptographic hash chains across audit logs.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CASEVAULT_AUDIT_HMAC_KEY=CHANGEME_GENERATE_64_HEX_CHAR_HMAC_KEY

# ==============================================================================
# Security Headers & Session Policy
# ==============================================================================
# Force HTTPS / HSTS (Set to True in production; False in local HTTP development)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Session Timeout (in seconds): Default 900 seconds (15 minutes of inactivity)
SESSION_COOKIE_AGE=900
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# Evidence Storage Directory (Absolute path or relative to project root)
EVIDENCE_STORAGE_PATH=./vault_storage
